# ---- Template for backend/.env (copy: `copy env.example backend\.env` on Windows) ----
# NOTE: Freebuff's workspace blocks writing dot-prefixed .env files, so this template
# lives as env.example. Copy it to backend/.env and fill in real values
# (the backend loads backend/.env first, then a repo-root .env).

# Text LLM (Groq). REQUIRED for anything LLM-related to work.
GROQ_API_KEY=your_groq_api_key_here
# Text model. Default: openai/gpt-oss-120b (llama-3.3-70b-versatile was retired
# from Groq's on-demand tier — see README known gaps)
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Vision-capable model from Groq's current model list (qwen/qwen3.8-27b works as of now)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# AssemblyAI. REQUIRED for streaming STT and for TTS (Voice Agent sessions).
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# TTS has no REST endpoint: backend/tts.py speaks each line via the Voice Agent
# WebSocket (wss://agents.assemblyai.com/v1/ws) using the session greeting.
# Override the endpoint here only if AssemblyAI changes it; default is baked in.
# ASSEMBLYAI_TTS_URL=wss://agents.assemblyai.com/v1/ws

# STT streaming endpoint (defaults live in backend/stt.py, overridable here)
# ASSEMBLYAI_STT_URL=wss://streaming.assemblyai.com/v3/ws?speech_model=universal-streaming-english&encoding=pcm_s16le&sample_rate=16000

# Optional overrides
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PORT=8000
# API_LOG_PATH=api_log.jsonl
# Set to 1 to run the engine with TTS fully off (used by scripts/test_engine_text_only.py)
# TTS_DISABLED=1
